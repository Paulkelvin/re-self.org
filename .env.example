# Sanity — copy to .env.local and fill in (find these at sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Write token (Editor/Deploy). Server-only — never exposed to the browser.
# Needed only to run `npm run seed`.
SANITY_WRITE_TOKEN=your_write_token
