# Sanity — copy to .env.local and fill in (find these at sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Write token (Editor/Deploy). Server-only — never exposed to the browser.
# Needed only to run `npm run seed`.
SANITY_WRITE_TOKEN=your_write_token

# Square Payment Gateway
SQUARE_ACCESS_TOKEN=your_square_access_token
SQUARE_LOCATION_ID=your_square_location_id
SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_BASE_URL=https://re-self.org

# Form delivery — Brevo (preferred) or SMTP fallback
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_NAME=Re-Self
BREVO_SENDER_EMAIL=no-reply@re-self.org
BOOKING_TO_EMAIL=sharris@re-self.org
BOOKING_BCC_EMAILS=paulopackager@gmail.com

# SMTP fallback (used only when BREVO_API_KEY is not set)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Re-Self <no-reply@re-self.org>"
